---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";

const posts = (await getCollection("blog"))
  .sort(
    (left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
  )
  .slice(0, 3);
---

<div class="blog-card-grid">
  {posts.map((post) => <BlogCard post={post} headingLevel="h3" />)}
</div>
<a href="/blog" class="section-link mt-6">See more <span aria-hidden="true">→</span><span class="sr-only"> posts</span></a>
