---
import Icon from "./Icon.astro";
---

<div class="relative">
  <button
    id="theme-toggle"
    type="button"
    class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-8 w-8 px-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-rose-700 dark:focus-visible:outline-rose-300"
    aria-label="Toggle theme"
  >
    <Icon name="sun" class="h-6 w-6 rotate-0 scale-100 motion-safe:transition-all dark:-rotate-90 dark:scale-0" />
    <Icon name="moon" class="absolute h-6 w-6 rotate-90 scale-0 motion-safe:transition-all dark:rotate-0 dark:scale-100" />
    <span class="sr-only">Toggle theme</span>
  </button>
</div>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      // The toggle still works when browser storage is unavailable.
    }
  });
</script>
