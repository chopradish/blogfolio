---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BlogToc from "../components/BlogToc.astro";
import FormattedDate from "../components/FormattedDate.astro";
import MainLayout from "./MainLayout.astro";
import "katex/dist/katex.min.css";

type Props = CollectionEntry<"blog">["data"] & {
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
} = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

<MainLayout title={title} description={description}>
	<div class="blog-shell">
		{sections.length > 0 && (
			<aside class="blog-sidebar">
				<nav class="blog-contents" aria-label="Table of contents">
					<p class="blog-contents-title">On this page</p>
					<BlogToc headings={headings} />
				</nav>
			</aside>
		)}
		<article class="blog-article">
			{heroImage && (
				<div class="mb-8">
					<Image
						src={heroImage}
						widths={[480, 720, 1020, 1664]}
						sizes="(min-width: 2000px) 832px, (min-width: 1200px) 704px, (min-width: 832px) 784px, calc(100vw - 3rem)"
						loading="eager"
						fetchpriority="high"
						class="block h-auto w-full rounded-lg"
						alt=""
					/>
				</div>
			)}

			<header class="blog-header">
				<div class="blog-date">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<div class="mt-1 italic">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
				<h1>{title}</h1>
				<p class="blog-description">{description}</p>
			</header>

			{sections.length > 0 && (
				<nav class="blog-contents blog-contents-inline" aria-label="Table of contents">
					<details>
						<summary>On this page</summary>
						<BlogToc headings={headings} />
					</details>
				</nav>
			)}

			<div class="prose blog-prose">
				<slot />
			</div>
		</article>
	</div>
</MainLayout>
