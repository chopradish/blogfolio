---
import BaseHead from "../components/BaseHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import personal from "../content/personal.json";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = personal.site.name, description = personal.site.description } =
  Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
    <script is:inline>
      // Theme initialization script - runs before page render to prevent flash
      const getTheme = () => {
        // Check localStorage first
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") return stored;
        } catch {
          // Fall back to the system theme if storage is blocked.
        }

        // Fall back to system preference
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const theme = getTheme();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      // Optional: Save the initial theme to localStorage if not set
      try {
        if (!localStorage.getItem("theme")) localStorage.setItem("theme", theme);
      } catch {
        // Theme switching does not require persistent storage.
      }
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-950 text-black dark:text-white antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="container z-40 bg-background">
        <div class="flex h-20 items-center align-middle justify-between py-6">
          <SiteNav items={personal.navigation.main} />
        </div>
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <SiteFooter currentPath={currentPath} />
    </div>
  </body>
</html>
