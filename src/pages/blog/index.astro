---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import personal from "../../content/personal.json";
import MainLayout from "../../layouts/MainLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MainLayout
  title={personal.site.name}
  description={personal.site.description}
>
	<main class="container flex flex-col gap-y-8 pb-8 pt-6 md:pb-12 md:pt-10">
		<section>
			<h1 class="mb-8 text-4xl font-bold">Blog</h1>
			<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
				{posts.map((post) => (
					<article class="group">
						<a href={`/blog/${post.id}/`} class="block">
							{post.data.heroImage && (
								<div class="mb-4 overflow-hidden rounded-lg">
									<Image
										width={720}
										height={360}
										src={post.data.heroImage}
										alt=""
										class="transition-transform group-hover:scale-105"
									/>
								</div>
							)}
							<h2 class="mb-2 text-xl font-semibold transition-colors group-hover:text-accent">
								{post.data.title}
							</h2>
							<p class="text-sm text-muted-foreground">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</article>
				))}
			</div>
		</section>
	</main>
</MainLayout>
