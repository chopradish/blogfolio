---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import personal from "../../content/personal.json";
import MainLayout from "../../layouts/MainLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MainLayout title={personal.site.name} description={personal.site.description}>
  <div class="container flex flex-col gap-y-8 pb-8 pt-6 md:pb-12 md:pt-10">
    <section aria-labelledby="blog-heading">
      <h1 id="blog-heading" class="mb-8 text-4xl font-bold">Blog</h1>
      <div class="blog-card-grid">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    </section>
  </div>
</MainLayout>
