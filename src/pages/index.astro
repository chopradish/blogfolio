---
import type { ImageMetadata } from "astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import RecentPosts from "../components/RecentPosts.astro";
import ThemePortrait from "../components/ThemePortrait.astro";
import Timeline from "../components/Timeline.astro";
import personal from "../content/personal.json";
import MainLayout from "../layouts/MainLayout.astro";

const { featuredProjects, home, profile } = personal;
const portraits = import.meta.glob<ImageMetadata>("/public/*shot.jpg", {
  eager: true,
  import: "default",
});
---

<MainLayout title={personal.site.name}>
  <div
    class="home-sections container flex flex-col pb-8 pt-6 md:pb-12 md:pt-10 lg:py-32"
  >
    <section
      id="hero"
      class="flex flex-col-reverse justify-between gap-5 sm:flex-row sm:items-center"
    >
      <div class="rows-span-1 col-span-1 col-start-1 max-w-md sm:col-span-4">
        <h1 class="text-5xl font-bold">{profile.name}</h1>
        <p class="mt-2 text-xl text-rose-700 dark:text-rose-300">
          {profile.headline}
        </p>

        <div class="text-gray-700 dark:text-gray-200 mt-8">
          {profile.intro}
        </div>
      </div>
      <div class="relative col-span-1 row-span-1 block aspect-square w-full max-w-96 shrink-0 sm:col-end-4 sm:w-64 lg:w-96">
        <ThemePortrait
          alt={profile.imageAlt}
          light={portraits[`/public${profile.image}`]}
          dark={portraits[`/public${profile.imageDark}`]}
        />
      </div>
    </section>

    <section id="recent-posts" aria-labelledby="recent-posts-heading">
      <h2 id="recent-posts-heading" class="home-section-heading text-3xl font-semibold mb-4">Recent Posts</h2>
      <RecentPosts />
    </section>

    <section id="timeline">
      <h2 class="home-section-heading text-3xl font-semibold mb-4">{home.timelineHeading}</h2>
      <Timeline filterable />
      <a href="/resume" class="section-link mt-6">Resume <span aria-hidden="true">→</span></a>
    </section>

    <section id="featured-projects">
      <h2 class="home-section-heading text-3xl font-semibold mb-4">{home.projectsHeading}</h2>
      <FeaturedProjects
        featuredProjects={featuredProjects}
        allProjectsUrl={home.allProjectsUrl}
      />
    </section>
  </div>
</MainLayout>
