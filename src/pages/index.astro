---
import { Image } from "astro:assets";
import { Projects } from "../components/Projects";
import { Timeline } from "../components/Timeline";
import personal from "../content/personal.json";
import MainLayout from "../layouts/MainLayout.astro";

const { careerEvents, featuredProjects, home, profile } = personal;
---

<MainLayout title={personal.site.name}>
  <main
    class="container flex flex-col gap-y-12 space-y-6 pb-8 pt-6 md:pb-12 md:pt-10 lg:py-32"
  >
    <section
      id="hero"
      class="flex flex-col-reverse justify-between gap-5 sm:flex-row sm:items-center"
    >
      <div class="rows-span-1 col-span-1 col-start-1 max-w-md sm:col-span-4">
          <h1 class="text-5xl font-bold">{profile.name}</h1>
        <h5 class="mt-2 text-xl text-rose-500 dark:text-rose-400">
          {profile.headline}
        </h5>

        <div class="text-gray-700 dark:text-gray-200 mt-8">
          {profile.intro}
        </div>
      </div>
      <div class="relative col-span-1 row-span-1 block sm:col-end-4">
        <Image
          alt={profile.imageAlt}
          src={profile.image}
          width="150"
          height="150"
          class="rounded-full"
        />
      </div>
    </section>

    <section id="timeline">
      <h3 class="text-3xl font-semibold mb-4">{home.timelineHeading}</h3>
      <Timeline careerEvents={careerEvents} client:load />
    </section>

    <section id="featured-projects">
      <h3 class="text-3xl font-semibold mb-4">{home.projectsHeading}</h3>
      <Projects
        featuredProjects={featuredProjects}
        allProjectsUrl={home.allProjectsUrl}
        client:load
      />
    </section>
  </main>
</MainLayout>
